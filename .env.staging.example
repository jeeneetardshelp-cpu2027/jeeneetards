# Copy this file to ".env.staging" and paste your STAGING project's values.
# .env.staging is git-ignored. NEVER put production values here — the test
# refuses to run if TEST_SUPABASE_URL matches the production URL in .env.
#
# Get these from the STAGING Supabase project:
#   Project Settings -> API -> Project URL / service_role / anon public

TEST_ALLOW=1
TEST_SUPABASE_URL=https://your-staging-ref.supabase.co
TEST_SERVICE_KEY=your-staging-service-role-key
TEST_ANON_KEY=your-staging-anon-key
