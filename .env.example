# Copy this file to ".env" and paste in your real values.
# Find both in Supabase: Project Settings -> API
#
# The anon key is designed to be public — it is safe in a frontend app,
# because Row Level Security decides what it may actually read or write.
# NEVER put the service_role key in this app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# YouTube Data API v3 — TWO SEPARATE KEYS, on purpose.
#
# Browser key. VITE_ = inlined into the public frontend bundle, so anyone can
# read it. Restrict it in Google Cloud Console by HTTP referrer AND to the
# YouTube Data API v3 only. Used by src/youtube.js (the admin panel importer).
# VITE_YOUTUBE_API_KEY was REMOVED on 2026-08-10. Vite inlines VITE_* into the
# public bundle, so it was a public key and a referrer restriction did not help.
# The admin YouTube calls now go through api/youtube.js using YOUTUBE_API_KEY.

# Server key. Never bundled, never sent to a browser. Used by the Node scripts
# (importChannel.js, backfillVideoMetadata.js), which fetch in bulk and can
# consume a lot of quota. Restrict this one by IP, not referrer — a referrer
# restriction would reject it, since a script sends no Referer header.
YOUTUBE_API_KEY=your-server-side-key

# Local import script only — never bundled, never deployed, never committed.
# Bypasses row-level security completely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
